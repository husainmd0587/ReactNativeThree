+/**
+ * CAD Practice — plugin manifest
+ *
+ * Technical id/module name stays `cadPractice` / `cad-practice` — this is a
+ * command PRACTICE system, not a full AutoCAD clone. `card` mirrors the
+ * shape MainStack's AllScreens entries already use (see
+ * src/navigation/MainStack.jsx) so registering the plugin doesn't require
+ * duplicating card metadata in two places.
+ */
+
+export const cadPracticeManifest = {
+  id: 'cad-practice',
+  name: 'AutoCAD Practice',
+  description: 'Practice 2D and 3D CAD commands on mobile, one command at a time.',
+  version: '1.0.0',
+  category: 'CAD',
+  enabled: true,
+
+  card: {
+    label: 'CAD Practice',
+    desc: 'Practice AutoCAD-style commands with instant feedback',
+    emoji: '📐',
+    accent: '#2E7DAF',
+    accentBg: '#E7F3FA',
+    slogan: [
+      'One command, one lesson.',
+      'Practice CAD commands anywhere.',
+      'Learn AutoCAD, hands-on.',
+    ],
+  },
+};
