@@ -0,0 +1,43 @@
+import React from 'react';
+import { createNativeStackNavigator } from '@react-navigation/native-stack';
+import CADPracticeHome from './screens/CADPracticeHome';
+import CommandPractice from './screens/CommandPractice';
+import { cadPracticeManifest } from './manifest';
+
+const Stack = createNativeStackNavigator();
+
+// Nested navigator for the plugin's own screens, matching the pattern
+// already used by other self-contained modules in this app (e.g.
+// src/mechanical_engineering/calculator/home.js) — MainStack registers
+// this whole component under one entry ("CAD Practice") and everything
+// past that point (home, command practice, future result screen) is owned
+// by the plugin.
+function CADPracticeNavigator() {
+  return (
+    <Stack.Navigator screenOptions={{ headerShown: true }}>
+      <Stack.Screen
+        name="CADPracticeHome"
+        component={CADPracticeHome}
+        options={{ title: 'CAD Practice' }}
+      />
+      <Stack.Screen
+        name="CommandPractice"
+        component={CommandPractice}
+        options={{ title: 'Command Practice' }}
+      />
+    </Stack.Navigator>
+  );
+}
+
+// Plugin contract (kept close to the spec's `cadPracticePlugin` shape) —
+// this is what src/app/plugins/pluginRegistry.js consumes.
+export const cadPracticePlugin = {
+  id: cadPracticeManifest.id,
+  name: cadPracticeManifest.name,
+  version: cadPracticeManifest.version,
+  enabled: cadPracticeManifest.enabled,
+  manifest: cadPracticeManifest,
+  component: CADPracticeNavigator,
+};
+
+export default cadPracticePlugin;
